{
    "name": "detain/phlix-plugin-omdb",
    "type": "phlix-plugin",
    "description": "OMDb metadata provider for Phlix — IMDb/RT/Metascore ratings aggregation for movies and TV.",
    "license": "MIT",
    "keywords": ["phlix", "phlix-plugin", "omdb", "ratings", "imdb", "rotten-tomatoes", "metascore", "metadata", "metadata-provider", "movies", "tv"],
    "homepage": "https://github.com/detain/phlix-plugin-omdb",
    "require": {
        "php": ">=8.3",
        "detain/phlix-shared": "^0.21.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^4.0",
        "workerman/http-client": "^1.0",
        "workerman/workerman": "^4.0"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/detain/phlix-shared.git" }
    ],
    "autoload": {
        "psr-4": {
            "Phlix\\Plugins\\Metadata\\Omdb\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phlix\\Plugins\\Metadata\\Omdb\\Tests\\": "tests/Unit/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse src --level=9",
        "phpcs": "vendor/bin/phpcs src --standard=PSR12"
    }
}
