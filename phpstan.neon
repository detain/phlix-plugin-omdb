parameters:
    level: 9
    paths:
        - src
    treatPhpDocTypesAsCertain: false
    # Zero ignoreErrors [M-OMDB-13]: the workerman v4-generation Timer::sleep
    # call is now behind a method_exists() guard phpstan can verify, replacing
    # the old "provided by host environment" paper-over (an ignore that hid a
    # latent fatal on the lock generation). Do not add ignores; guard in code.
